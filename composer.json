{
    "name": "alexhackney/laravel-zammad",
    "description": "Zammad helpdesk API client for Laravel, built on Saloon",
    "keywords": [
        "zammad",
        "laravel",
        "helpdesk",
        "saloon",
        "api"
    ],
    "homepage": "https://github.com/alexhackney/laravel-zammad",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Hackney",
            "email": "alex@alexhackney.com"
        }
    ],
    "support": {
        "issues": "https://github.com/alexhackney/laravel-zammad/issues",
        "source": "https://github.com/alexhackney/laravel-zammad"
    },
    "require": {
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "php": "^8.3",
        "saloonphp/laravel-plugin": "^4.0|^5.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-package-tools": "^1.93",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AlexHackney\\Zammad\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexHackney\\Zammad\\Tests\\": "tests"
        }
    },
    "bin": [
        "bin/migrate-from-codebar"
    ],
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexHackney\\Zammad\\ZammadServiceProvider"
            ],
            "aliases": {
                "Zammad": "AlexHackney\\Zammad\\Facades\\Zammad"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
